{
  "name": "openclaw-feishu-a2a-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "registry": "powershell -ExecutionPolicy Bypass -File scripts/start-registry.ps1",
    "gateway": "powershell -ExecutionPolicy Bypass -File scripts/start-a2a.ps1",
    "worker": "powershell -ExecutionPolicy Bypass -File scripts/start-worker.ps1",
    "skill-evolution": "powershell -ExecutionPolicy Bypass -File scripts/start-skill-evolution.ps1",
    "bridge": "a2a-server\\.venv\\Scripts\\python.exe scripts\\run-services.py",
    "bridge:mock": "powershell -ExecutionPolicy Bypass -Command \"$env:A2A_MOCK='1'; & 'a2a-server\\.venv\\Scripts\\python.exe' 'scripts\\run-services.py'\"",
    "build": "npm --prefix manager-a2a-plugin run plugin:build && npm --prefix registry-web run build",
    "build:web": "npm --prefix registry-web run build",
    "dev:web": "npm --prefix registry-web run dev",
    "test": "npm --prefix manager-a2a-plugin test && set \"PYTHONPATH=a2a-server;registry-service;skill-evolution-service\"&& a2a-server\\.venv\\Scripts\\python.exe -m pytest a2a-server\\tests registry-service\\tests skill-evolution-service\\tests",
    "smoke": "a2a-server\\.venv\\Scripts\\python.exe scripts\\smoke.py"
  }
}
