# ============================================================
# A2A Registry + Gateway 部署环境变量
# 复制为 .env 后按实际环境修改
# ============================================================

# ---- 对外暴露的地址（必改）----
# 替换为 Linux 服务器的实际 IP 或域名
REGISTRY_PUBLIC_URL=http://your-server-ip:4200
A2A_PUBLIC_URL=http://your-server-ip:4101
A2A_GATEWAY_PUBLIC_URL=http://your-server-ip:4101

# ---- 密钥与 Token（必改）----
# Registry 加密 Agent 凭证的密钥，绝对不能泄露，重启不能变
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REGISTRY_SECRET_KEY=

# Gateway 与 Registry 内部通信的令牌
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
REGISTRY_SERVICE_TOKEN=change-me-service-token

# ---- 可选 ----
# Agent 自注册端点保护令牌
REGISTRY_REGISTRATION_TOKEN=

# Registry 管理 API 保护令牌
REGISTRY_ADMIN_TOKEN=

# OpenClaw Gateway 令牌（调用 openclaw-responses adapter 时需要）
OPENCLAW_GATEWAY_TOKEN=

# ---- RabbitMQ 任务队列 ----
RABBITMQ_PASSWORD=change-me-rabbitmq
A2A_BROKER_URL=amqp://a2a:change-me-rabbitmq@127.0.0.1:5672/
A2A_QUEUE_PREFIX=a2a.task
A2A_QUEUE_PARTITIONS=8
# Must exceed managed Agent backend timeouts; the lease must exceed this wait.
A2A_QUEUE_RESULT_TIMEOUT_SECONDS=1800
A2A_WORKER_LEASE_SECONDS=2400

# ---- Manager 定时 Skill 进化（默认关闭）----
SKILL_EVOLUTION_ENABLED=0
SKILL_EVOLUTION_POLICY_FILE=./config/skill-evolution-policies.json
SKILL_EVOLUTION_DB=./.runtime/skill-evolution.sqlite3
SKILL_EVOLUTION_CANDIDATE_DIR=./.runtime/skill-candidates
SKILL_EVOLUTION_POLL_SECONDS=15
SKILL_EVOLUTION_LEASE_SECONDS=3600
SKILL_EVOLUTION_MANAGER_TIMEOUT_SECONDS=900

# MemOS Cloud OpenMem API。
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
# MEMOS_API_KEY 是官方变量名；MEMOS_TOKEN 作为兼容别名继续受支持。
MEMOS_API_KEY=
MEMOS_TOKEN=
MEMOS_USER_ID=openclaw-user
MEMOS_APP_ID=a2a-coordination
MEMOS_ALLOW_PUBLIC=0
MEMOS_ASYNC_MODE=0
MEMOS_TIMEOUT_SECONDS=30

# ---- Agent 任务后经验采集（需要 RabbitMQ 和 MemOS Cloud）----
# 正式结果返回后异步调用原 Agent 反思，不阻塞 Manager 回复用户。
AGENT_EXPERIENCE_ENABLED=0

# SkillHub 原生 HTTP API。Token 需包含 skill:read 与 skill:publish scope。
SKILLHUB_REGISTRY=http://127.0.0.1:8080
SKILLHUB_API_TOKEN=replace-with-a-skillhub-api-token
SKILLHUB_TIMEOUT_SECONDS=300

# Mock 模式（设为 1 跳过真实 OpenClaw 调用，用于测试）
A2A_MOCK=0

# 启动种子文件路径（容器内路径）
REGISTRY_BOOTSTRAP_FILE=/config/planner-agent.json
