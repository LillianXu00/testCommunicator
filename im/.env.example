COMPOSE_PROJECT_NAME=im-stack
TZ=UTC
PUBLIC_BASE_URL=http://localhost
HUMHUB_VERSION=1.17.2
HUMHUB_DB_NAME=humhub
HUMHUB_DB_USER=humhub
HUMHUB_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
HUMHUB_ADMIN_USERNAME=admin
HUMHUB_ADMIN_EMAIL=admin@example.com
HUMHUB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
HUMHUB_SERVICE_ACCOUNT_TOKEN=CHANGE_ME_HUMHUB_API_TOKEN
HUMHUB_SERVICE_ACCOUNT_GUID=SERVICE_ACCOUNT_GUID_OPTIONAL
HUMHUB_BASE_URL=http://humhub
HUMHUB_DEFAULT_SPACE_ID=1
HUMHUB_REST_MODULE_VERSION=1.0.1
HUMHUB_JWT_SSO_MODULE_VERSION=1.0.2
JWT_SSO_SHARED_SECRET=CHANGE_ME_JWT_SSO_SECRET
JWT_SSO_ISSUER=im-auth-broker
JWT_SSO_AUDIENCE=humhub
JWT_SSO_ADMIN_REDIRECT_PATH=/
ADAPTER_BEARER_TOKEN=CHANGE_ME_ADAPTER_TOKEN
ADAPTER_LOG_LEVEL=INFO
ADAPTER_DEFAULT_TIMEOUT=20
ADAPTER_INTERNAL_PORT=8000
AUTH_BROKER_INTERNAL_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=_
SSL_CERT_PATH=/etc/nginx/certs/server.crt
SSL_KEY_PATH=/etc/nginx/certs/server.key
MAX_UPLOAD_SIZE=20m
ENABLE_AUTH_BROKER=true
ENABLE_HTTPS=false
LETSENCRYPT_EMAIL=
OPENCLAW_DEFAULT_EXTERNAL_ID_PREFIX=openclaw
